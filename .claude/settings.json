{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --no-verify *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "mcp__playwright-household__browser_run_code_unsafe",
      "mcp__playwright-household__browser_file_upload",
      "mcp__playwright-household__browser_drop",
      "mcp__playwright-household__browser_network_request",
      "mcp__playwright-investor__browser_run_code_unsafe",
      "mcp__playwright-investor__browser_file_upload",
      "mcp__playwright-investor__browser_drop",
      "mcp__playwright-investor__browser_network_request",
      "mcp__playwright-mixed__browser_run_code_unsafe",
      "mcp__playwright-mixed__browser_file_upload",
      "mcp__playwright-mixed__browser_drop",
      "mcp__playwright-mixed__browser_network_request"
    ],
    "ask": [
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git tag -f *)",
      "Bash(git tag --force *)",
      "Bash(git push origin :refs/tags/*)",
      "Bash(git push --delete origin v*)",
      "Bash(git push origin --delete v*)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh release upload *)"
    ],
    "allow": [
      "Bash(gh pr merge * --squash --delete-branch)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(git tag -a v*)",
      "Bash(git push origin v*)",
      "Bash(gh release create v*)"
    ]
  }
}
