# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git (see the root .gitignore). Vite only exposes variables prefixed
# VITE_ to client code — see https://vite.dev/guide/env-and-mode.

# Where apps/api runs. Its own CORS policy (WEB_ORIGIN, apps/api/.env.example) must allow
# this app's own origin, e.g. http://localhost:5173 in development (the default either way).
VITE_API_URL=http://127.0.0.1:3000
