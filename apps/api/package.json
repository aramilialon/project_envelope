{
  "name": "@envelope/api",
  "version": "0.0.0",
  "private": true,
  "description": "envelope backend: API, sync and background jobs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "test:integration": "node --test --test-concurrency=1 $(find src -name '*.test.ts' -not -path 'src/smoke/*')",
    "test:smoke": "node --test --test-concurrency=1 $(find src/smoke -name '*.test.ts')",
    "test": "pnpm run test:integration && echo && echo '== Smoke tests (ADR 0007) ==' && pnpm run test:smoke",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@envelope/core": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3"
  }
}
