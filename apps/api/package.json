{
  "name": "@envelope/api",
  "version": "0.0.0",
  "private": true,
  "description": "envelope backend: API, sync and background jobs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "fx-rates:import": "node --env-file-if-exists=.env src/market-data/import-fx-rates-command.ts",
    "test:integration": "node --test --test-global-setup=src/test-helpers/keycloak-global-setup.ts ${API_TEST_CONCURRENCY:+--test-concurrency=$API_TEST_CONCURRENCY} $(find src -name '*.test.ts' -not -path 'src/smoke/*')",
    "test:smoke": "node --test --test-concurrency=1 --test-global-setup=src/test-helpers/keycloak-global-setup.ts $(find src/smoke -name '*.test.ts')",
    "test": "pnpm run test:integration && echo && echo '== Smoke tests (ADR 0007) ==' && pnpm run test:smoke",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@envelope/core": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.3"
  }
}
