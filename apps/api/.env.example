# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git (see the root .gitignore).

# Connection string for the "envelope" database created by infra/docker-compose.yml.
# Replace the password with the one set in infra/.env.
DATABASE_URL=postgres://envelope:change-me-postgres@127.0.0.1:5432/envelope

# The realm access tokens must come from, and the client id (audience) they must carry.
# Create this realm and client in the Keycloak console (infra/docker-compose.yml) once.
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/envelope
KEYCLOAK_AUDIENCE=envelope-api

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development
