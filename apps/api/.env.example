# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git (see the root .gitignore).

# The migration runner's connection: needs DDL privileges, so it uses the superuser
# from infra/docker-compose.yml. Replace the password with the one set in infra/.env.
# The running server never uses this one; see APP_DATABASE_URL below (ADR 0006).
DATABASE_URL=postgres://envelope:change-me-postgres@127.0.0.1:5432/envelope

# The server's own connection: envelope_app, restricted by Row-Level Security (ADR 0006).
# Give it a login once, on the Postgres server (not in a migration, not in this file's
# committed example): `ALTER ROLE envelope_app WITH LOGIN PASSWORD '<a password you pick>';`
# then use that password here. See apps/api/README.md for the full command.
APP_DATABASE_URL=postgres://envelope_app:change-me-app@127.0.0.1:5432/envelope

# The queue module's own connection (#34): envelope_queue, which pg-boss uses to manage its
# own schema — DDL envelope_app deliberately cannot do. Give it a login the same way, once:
# `ALTER ROLE envelope_queue WITH LOGIN PASSWORD '<a password you pick>';`
QUEUE_DRIVER=postgres
QUEUE_DATABASE_URL=postgres://envelope_queue:change-me-queue@127.0.0.1:5432/envelope

# VAPID credentials for the web push adapter (#39), required to start the server since the
# budget-recompute job (#40) registers a real handler that can send through it. Generate a
# pair once with `npx web-push generate-vapid-keys`; obtaining and configuring these for a
# real deployment is documented in a how-to guide (#41).
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The realm access tokens must come from, and the client id (audience) they must carry.
# Create this realm and client once, against the Keycloak in infra/docker-compose.yml:
# KEYCLOAK_ADMIN_PASSWORD=<password from infra/.env> scripts/keycloak/bootstrap.sh
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/envelope
KEYCLOAK_AUDIENCE=envelope-api

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development

# The web app's own origin (#48): the only one the API's CORS policy allows. Defaults to
# Vite's own dev server port, so local development needs no change here.
WEB_ORIGIN=http://localhost:5173

# The reverse proxies whose X-Forwarded-For the API believes (#566): comma-separated addresses or
# CIDR ranges, never "true" or "*". Leave empty when clients connect to the API directly (an SSH
# tunnel included); set it to 127.0.0.1 when Caddy (infra/Caddyfile) fronts it on this machine, or
# every device on the network is counted as one address under the per-address limit below.
TRUST_PROXY=

# Request limits (#566, ADR 0017); the defaults are shown. An ordinary web session sends about 325
# requests in 7 seconds. Per client address, every route counted; keep it above RATE_LIMIT_USER_MAX,
# since one address can carry several members:
# RATE_LIMIT_IP_MAX=2400
# RATE_LIMIT_IP_WINDOW_SECONDS=60
# Per signed-in user: every request, then writes (POST, PUT, PATCH, DELETE), then file imports.
# RATE_LIMIT_USER_MAX=1200
# RATE_LIMIT_USER_WINDOW_SECONDS=60
# RATE_LIMIT_USER_WRITE_MAX=120
# RATE_LIMIT_USER_IMPORT_MAX=10
