# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git (see the root .gitignore).

# The migration runner's connection: needs DDL privileges, so it uses the superuser
# from infra/docker-compose.yml. Replace the password with the one set in infra/.env.
# The running server never uses this one; see APP_DATABASE_URL below (ADR 0006).
DATABASE_URL=postgres://envelope:change-me-postgres@127.0.0.1:5432/envelope

# The server's own connection: envelope_app, restricted by Row-Level Security (ADR 0006).
# Give it a login once, on the Postgres server (not in a migration, not in this file's
# committed example): `ALTER ROLE envelope_app WITH LOGIN PASSWORD '<a password you pick>';`
# then use that password here. See apps/api/README.md for the full command.
APP_DATABASE_URL=postgres://envelope_app:change-me-app@127.0.0.1:5432/envelope

# The realm access tokens must come from, and the client id (audience) they must carry.
# Create this realm and client once, against the Keycloak in infra/docker-compose.yml:
# KEYCLOAK_ADMIN_PASSWORD=<password from infra/.env> scripts/keycloak/bootstrap.sh
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/envelope
KEYCLOAK_AUDIENCE=envelope-api

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development
