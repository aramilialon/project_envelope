# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git (see the root .gitignore).

# The superuser connection (the same one apps/api's own tests and apps/web's e2e tests use for
# fixture setup) — needed for the one step seed-demo.ts does with direct SQL: creating and, on
# --reset, deleting the "Demo" workspace and its first membership (see scripts/README.md).
DATABASE_URL=postgres://envelope:change-me-postgres@127.0.0.1:5432/envelope

# The value from infra/.env — needed to create the persistent "demo" Keycloak user through the
# admin API (self-registration is disabled on this realm by design).
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# A password you pick for the persistent "demo" Keycloak user. Not a secret worth protecting
# beyond "not committed": this account only ever holds throwaway demo data on your own machine.
DEMO_USER_PASSWORD=change-me-demo

# Defaults already match a local apps/api/apps/web dev setup; override only if yours differs.
API_URL=http://127.0.0.1:3000
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_AUDIENCE=envelope-api
