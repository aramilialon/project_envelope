#!/usr/bin/env bash
# Refuses pushes to main from this clone: changes reach main through pull requests.
# Activate once per clone with: git config core.hooksPath scripts/git-hooks
# A person who really needs to push to main can run: ENVELOPE_ALLOW_MAIN_PUSH=1 git push ...
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" && "${ENVELOPE_ALLOW_MAIN_PUSH:-}" != "1" ]]; then
    echo "Push to main refused: push a branch and open a pull request instead." >&2
    exit 1
  fi
done
exit 0
