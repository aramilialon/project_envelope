{
  "name": "@envelope/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Development scripts: Keycloak realm bootstrap, GitHub setup, demo data seed, disposable environments, changelog release",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "seed:demo": "node --env-file-if-exists=.env seed-demo.ts",
    "screenshots:demo": "node --env-file-if-exists=.env screenshot-demo.ts",
    "screenshots:mockups": "node screenshot-mockups.ts",
    "explore:up": "node --env-file-if-exists=.env explore-env/cli.ts up",
    "explore:down": "node --env-file-if-exists=.env explore-env/cli.ts down",
    "explore:sweep": "node --env-file-if-exists=.env explore-env/cli.ts sweep",
    "explore:agents": "node explore-env/explorer-agents.ts",
    "install:up": "node install-env/cli.ts up",
    "install:down": "node install-env/cli.ts down",
    "install:status": "node install-env/cli.ts status",
    "changelog:check": "node changelog-release.ts --check",
    "changelog:release": "node changelog-release.ts",
    "test": "node --test \"lib/**/*.test.ts\" \"explore-env/**/*.test.ts\" \"install-env/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.84",
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1"
  }
}
