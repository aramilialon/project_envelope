# Copy this file to .env and change the passwords: .env never goes into the repository.
#   cp .env.example .env

POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Image versions. Before starting, check the latest stable release and update here:
#   PostgreSQL: https://hub.docker.com/_/postgres
#   Keycloak:   https://www.keycloak.org/downloads
POSTGRES_VERSION=17
KEYCLOAK_VERSION=26.0
